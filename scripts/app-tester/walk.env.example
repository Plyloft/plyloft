# Walk tooling configuration: copy this file to scripts/app-tester/walk.env
# (git-ignored, never exported) and replace every placeholder. Read by
# walk-config.sh (make-instance-env.sh, ply-test-mcp-wrapper.sh, vm-build.sh,
# vm-profile.sh) and walk-config.mjs (team-walk/*.mjs). A variable set in the
# environment wins over this file; PLY_WALK_ENV points at another file.
# Plain KEY=value lines, no shell expansion (Node reads this file too).
# build-mcp.sh copies this file beside the installed MCP wrapper: run it again
# after an edit.
# docs/app-tester/DESIGN.md, "Walk configuration".

# The team walk's owner: the GitHub login the owner instance (Plyloft Test,
# ~/Library/Application Support/ply-test-owner) answers as, and its numeric
# GitHub id (gh api users/<login> --jq .id), used in its commit e-mail.
PLY_WALK_OWNER_LOGIN=your-owner-login
PLY_WALK_OWNER_ID=1000001

# The team walk's member: a second GitHub account, the member instance's
# (Plyloft Test Member, ply-test-member), and its numeric GitHub id.
PLY_WALK_MEMBER_LOGIN=your-member-login
PLY_WALK_MEMBER_ID=1000002

# The sandbox repository walks may write to (owner/name), and the test team's
# library repository (owner/name). The ply-test MCP (tools/ply-test-mcp,
# readers.rs) pins the same two names: keep them equal.
PLY_WALK_SANDBOX_REPO=your-owner-login/plyloft-ci-sandbox
PLY_WALK_TEAM_REPO=your-owner-login/plyloft-test-team

# The client id of your development GitHub OAuth App (Device Flow on), which
# the MCP wrapper gives Plyloft Test as PLYLOFT_GITHUB_CLIENT_ID.
PLY_WALK_DEV_GITHUB_CLIENT_ID=YOUR_DEV_OAUTH_CLIENT_ID

# Optional: the Parallels Windows VM's name (vm-build.sh, vm-profile.sh).
PLY_TEST_VM="Windows 11"
